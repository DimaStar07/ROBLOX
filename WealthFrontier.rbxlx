  <Item class="ReplicatedStorage" referent="RBX_REPLICATED">
    <Item class="Folder" referent="">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="RBXF0E4011F92624F268E4D99B2CC9C2F5B">
        <Properties>
          <string name="Name">MarketConfig</string>
          <ProtectedString name="Source">local MarketConfig = {}

MarketConfig.CashName = "Credits"
MarketConfig.StartingCash = 25_000
MarketConfig.TradeCommission = 0.0025
MarketConfig.CashoutCommission = 0.05
MarketConfig.OfflineDividendCapDays = 7
MarketConfig.MaxOrdersPerMinute = 12
MarketConfig.MaxCasinoLossPerDay = 2_000

MarketConfig.Assets = {
	NEO = { name = "Neo Systems", sector = "Technology", basePrice = 120, volatility = 0.018, dividendRate = 0.0006 },
	SKY = { name = "Skyline Energy", sector = "Energy", basePrice = 88, volatility = 0.025, dividendRate = 0.0009 },
	HOME = { name = "Horizon Homes", sector = "Real Estate", basePrice = 160, volatility = 0.012, dividendRate = 0.0011 },
	MOVE = { name = "Metro Motors", sector = "Transport", basePrice = 72, volatility = 0.021, dividendRate = 0.0005 },
	GOLD = { name = "Red Gold Union", sector = "Metals", basePrice = 210, volatility = 0.014, dividendRate = 0.0004 },
	MED = { name = "Nova Health", sector = "Healthcare", basePrice = 145, volatility = 0.016, dividendRate = 0.0007 },
	FOOD = { name = "Green Fork", sector = "Consumer", basePrice = 54, volatility = 0.02, dividendRate = 0.0008 },
	BIT = { name = "Bit Harbor", sector = "Crypto", basePrice = 305, volatility = 0.045, dividendRate = 0.0002 },
}

MarketConfig.Outfits = {
	{ id = "street_basic", name = "Basic Streetwear", price = 0 },
	{ id = "office_suit", name = "Silver Office Suit", price = 8_000 },
	{ id = "nightwear", name = "Midnight Jacket", price = 24_000 },
	{ id = "luxury_gold", name = "Gold Executive Look", price = 120_000 },
}

MarketConfig.Cars = {
	{ id = "old_sedan", name = "Old Sedan", price = 12_000 },
	{ id = "city_coupe", name = "City Coupe", price = 55_000 },
	{ id = "electric_gt", name = "Electric GT", price = 240_000 },
}

MarketConfig.Properties = {
	{ id = "old_room", name = "Old Room", price = 0, income = 0 },
	{ id = "city_apartment", name = "City Apartment", price = 90_000, income = 280 },
	{ id = "penthouse", name = "Downtown Penthouse", price = 600_000, income = 1_800 },
	{ id = "mansion", name = "Lakeside Mansion", price = 2_500_000, income = 7_500 },
}

return table.freeze(MarketConfig)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Lighting" referent="RBX_LIGHTING">
    <Properties>
      <float name="Brightness">2</float>
