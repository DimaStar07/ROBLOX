local function createButton(name, text, x, y, color)
	local button = Instance.new("TextButton")
	button.Name = name
	button.Text = text
	button.Size = UDim2.new(0, 150, 0, 44)
	button.Position = UDim2.new(0, x, 0, y)
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.TextColor3 = Color3.new(1, 1, 1)
	button.AutoButtonColor = true
	button.Parent = tradePanel
	return button
end

local buyButton = createButton("Buy", "BUY", 12, 272, Color3.fromRGB(24, 142, 103))
local sellButton = createButton("Sell", "SELL", 174, 272, Color3.fromRGB(160, 61, 61))
local questButton = createButton("Quest", "CLAIM FIRST TRADE", 12, 326, Color3.fromRGB(54, 92, 160))

local status = Instance.new("TextLabel")
status.Name = "Status"
status.Size = UDim2.new(1, -24, 0, 48)
status.Position = UDim2.new(0, 12, 0, 378)
status.BackgroundTransparency = 1
status.Text = "Server status: offline until first snapshot"
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.TextWrapped = true
status.TextColor3 = Color3.fromRGB(175, 188, 209)
status.Parent = tradePanel

local snapshot
local function refresh()
	snapshot = remote:InvokeServer("snapshot")
	if not snapshot then
		status.Text = "Unable to load the server profile"
		return
	end

	cashLabel.Text = ("CREDITS  %s"):format(string.format("%d", snapshot.cash))
	worthLabel.Text = ("NET WORTH  %s"):format(string.format("%d", snapshot.netWorth))

	local rows = {}
	for symbol, asset in pairs(Config.Assets) do
		local price = snapshot.prices[symbol] or asset.basePrice
		local held = snapshot.holdings[symbol] or 0
		table.insert(rows, string.format("%-4s  %8d  OWN %d", symbol, math.floor(price), held))
	end
	table.sort(rows)
	watchlist.Text = table.concat(rows, "\n")
	status.Text = "Live server snapshot"
end

buyButton.Activated:Connect(function()
	local ok, message = remote:InvokeServer("trade", string.upper(symbolBox.Text), tonumber(quantityBox.Text), false)
	status.Text = message or tostring(ok)
	refresh()
end)

sellButton.Activated:Connect(function()
	local ok, message = remote:InvokeServer("trade", string.upper(symbolBox.Text), tonumber(quantityBox.Text), true)
	status.Text = message or tostring(ok)
	refresh()
end)

questButton.Activated:Connect(function()
	local ok, message = remote:InvokeServer("quest")
	status.Text = message or tostring(ok)
	refresh()
end)

task.spawn(function()
	while true do
		refresh()
		task.wait(5)
	end
end)
