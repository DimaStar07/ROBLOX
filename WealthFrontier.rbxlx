  </Item>
  <Item class="ServerScriptService" referent="RBX_SSS">
    <Item class="Script" referent="RBX1B32C1C81DEC4BCA8B7CFA98D86CCB9D">
      <Properties>
        <string name="Name">EconomyManager</string>
        <bool name="Enabled">true</bool>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- Runtime bootstrap is intentionally duplicate-safe: if Studio import loses
-- static parts, a server Script creates the essential playable ground before
-- the first client simulation begins.
do
	local world = workspace
	if not world:FindFirstChild("RuntimeTestGround") then
		local ground = Instance.new("Part")
		ground.Name = "RuntimeTestGround"
		ground.Anchored = true
		ground.Size = Vector3.new(500, 4, 500)
		ground.Position = Vector3.new(0, -2, 0)
		ground.BrickColor = BrickColor.new("Medium stone grey")
		ground.Parent = world

		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "WealthFrontierSpawn"
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Enabled = true
		spawn.Size = Vector3.new(12, 1, 12)
		spawn.Position = Vector3.new(0, 1, 0)
		spawn.BrickColor = BrickColor.new("Lily white")
		spawn.Parent = world
	end

	local landmark = world:FindFirstChild("CentralLandmark")
	if not landmark then
		local part = Instance.new("Part")
		part.Name = "CentralLandmark"
		part.Anchored = true
		part.Size = Vector3.new(40, 60, 40)
		part.Position = Vector3.new(0, 30, 0)
		part.BrickColor = BrickColor.new("Bright yellow")
		part.Parent = world
	end
end

local Config = require(ReplicatedStorage.Modules.MarketConfig)
local profileStore = DataStoreService:GetDataStore("WealthFrontierProfilesV1")
local leaderboardStore = DataStoreService:GetOrderedDataStore("WealthFrontierNetWorthV1")

local Remote = ReplicatedStorage:FindFirstChild("EconomyRemote") or Instance.new("RemoteFunction")
Remote.Name = "EconomyRemote"
Remote.Parent = ReplicatedStorage

local profiles = {}
local marketPrices = {}
local candles = {}

for symbol, asset in pairs(Config.Assets) do
	marketPrices[symbol] = asset.basePrice
	candles[symbol] = {}
end

local defaultProfile = function()
	local holdings = {}
	for symbol in pairs(Config.Assets) do
		holdings[symbol] = 0
	end

	return {
		cash = Config.StartingCash,
		holdings = holdings,
		outfit = "street_basic",
		car = "old_sedan",
		property = "old_room",
		ownedOutfits = { street_basic = true },
		ownedCars = { old_sedan = true },
		ownedProperties = { old_room = true },
		lastSaveUnix = os.time(),
		lastDividendUnix = os.time(),
		lastCasinoUnix = 0,
		casinoLossToday = 0,
		quests = {},
		clan = nil,
		tradeHistory = {},
	}
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in pairs(value) do
		copy[key] = deepCopy(child)
	end
	return copy
end

local function sanitizeProfile(profile)
	local clean = defaultProfile()
	for key, value in pairs(profile or {}) do
		clean[key] = deepCopy(value)
	end
	clean.cash = math.clamp(tonumber(clean.cash) or Config.StartingCash, 0, 1e12)
	clean.holdings = clean.holdings or {}
	clean.ownedOutfits = clean.ownedOutfits or { street_basic = true }
	clean.ownedCars = clean.ownedCars or { old_sedan = true }
	clean.ownedProperties = clean.ownedProperties or { old_room = true }
	clean.tradeHistory = clean.tradeHistory or {}
	clean.lastDividendUnix = tonumber(clean.lastDividendUnix) or os.time()
	return clean
end

local function netWorth(profile)
	local worth = profile.cash
	for symbol, quantity in pairs(profile.holdings) do
		worth += quantity * (marketPrices[symbol] or Config.Assets[symbol].basePrice)
	end
	return math.floor(worth)
end

local function saveProfile(player)
	local profile = profiles[player.UserId]
	if not profile then
		return
	end
	profile.lastSaveUnix = os.time()
	profileStore:UpdateAsync(tostring(player.UserId), function(old)
		return sanitizeProfile(profile)
	end)
	leaderboardStore:SetAsync(tostring(player.UserId), netWorth(profile))
end

local function loadProfile(player)
	local success, stored = pcall(profileStore.UpdateAsync, profileStore, tostring(player.UserId), function(old)
		return old or nil
	end)
	if not success then
		stored = nil
	end

	local profile = sanitizeProfile(stored)
	profiles[player.UserId] = profile

	local elapsedSeconds = math.max(0, os.time() - profile.lastDividendUnix)
	local elapsedDays = math.min(Config.OfflineDividendCapDays, elapsedSeconds / 86400)
	local dividend = 0
	for symbol, quantity in pairs(profile.holdings) do
		local asset = Config.Assets[symbol]
		dividend += quantity * asset.basePrice * asset.dividendRate * elapsedDays
	end
	if dividend &gt; 0 then
		profile.cash += math.floor(dividend)
	end
	profile.lastDividendUnix = os.time()

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local cash = Instance.new("IntValue")
	cash.Name = "Credits"
	cash.Value = profile.cash
	cash.Parent = leaderstats

	local worth = Instance.new("IntValue")
	worth.Name = "NetWorth"
	worth.Value = netWorth(profile)
	worth.Parent = leaderstats
end

Players.PlayerAdded:Connect(loadProfile)
Players.PlayerRemoving:Connect(function(player)
	saveProfile(player)
	profiles[player.UserId] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(loadProfile, player)
end

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		saveProfile(player)
	end
end)

task.spawn(function()
	while true do
		task.wait(15)
		for symbol, asset in pairs(Config.Assets) do
			local change = (math.random() * 2 - 1) * asset.volatility
			local nextPrice = marketPrices[symbol] * (1 + change)
			marketPrices[symbol] = math.max(1, math.floor(nextPrice * 100) / 100)
		end
		for _, player in ipairs(Players:GetPlayers()) do
			local profile = profiles[player.UserId]
			if profile then
				local leaderstats = player:FindFirstChild("leaderstats")
				if leaderstats then
					leaderstats.Credits.Value = profile.cash
					leaderstats.NetWorth.Value = netWorth(profile)
				end
				leaderboardStore:SetAsync(tostring(player.UserId), netWorth(profile))
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			local profile = profiles[player.UserId]
			if not profile then
				continue
			end
			for _, item in ipairs(Config.Properties) do
				if profile.property == item.id then
					profile.cash += item.income
					break
				end
			end
		end
	end
end)

local function getProfile(player)
	return profiles[player.UserId]
end

local function trade(player, symbol, quantity, sell)
	local profile = getProfile(player)
	local asset = Config.Assets[symbol]
	if not profile or not asset or type(quantity) ~= "number" then
		return false, "Invalid trade"
	end
	quantity = math.floor(quantity)
	if quantity &lt; 1 or quantity &gt; 100_000 then
		return false, "Invalid quantity"
	end

	local price = marketPrices[symbol]
	local cost = math.floor(price * quantity * (1 + Config.TradeCommission))
	if sell then
		local held = profile.holdings[symbol] or 0
		if held &lt; quantity then
			return false, "Not enough assets"
		end
		profile.holdings[symbol] -= quantity
		local proceeds = math.floor(price * quantity * (1 - Config.TradeCommission))
		profile.cash += proceeds
	else
		if profile.cash &lt; cost then
			return false, "Not enough credits"
		end
		profile.cash -= cost
		profile.holdings[symbol] = (profile.holdings[symbol] or 0) + quantity
	end

	table.insert(profile.tradeHistory, 1, {
		symbol = symbol,
		quantity = quantity,
		price = price,
		sell = sell,
		unix = os.time(),
	})
	table.remove(profile.tradeHistory, 21)
	saveProfile(player)
	return true, sell and "Asset sold" or "Asset bought"
end

local function purchase(player, category, id)
	local profile = getProfile(player)
	if not profile then
		return false, "Profile unavailable"
	end

	local catalog
	if category == "outfit" then
		catalog = Config.Outfits
	elseif category == "car" then
		catalog = Config.Cars
	elseif category == "property" then
		catalog = Config.Properties
	else
		return false, "Invalid category"
	end

	for _, item in ipairs(catalog) do
		if item.id == id then
			if category == "outfit" and profile.ownedOutfits[id] then
				profile.outfit = id
				return true, "Outfit equipped"
			end
			if category == "car" and profile.ownedCars[id] then
				return true, "Vehicle equipped"
			end
			if category == "property" and profile.ownedProperties[id] then
				profile.property = id
				return true, "Property moved"
			end
			if profile.cash &lt; item.price then
				return false, "Not enough credits"
			end
			profile.cash -= item.price
			if category == "outfit" then
				profile.ownedOutfits[id] = true
				profile.outfit = id
			elseif category == "car" then
				profile.ownedCars[id] = true
				profile.car = id
			else
				profile.ownedProperties[id] = true
				profile.property = id
			end
			saveProfile(player)
			return true, "Purchase complete"
		end
	end
	return false, "Catalog item missing"
end

Remote.OnServerInvoke = function(player, action, ...)
	local args = table.pack(...)
	if action == "snapshot" then
		local profile = getProfile(player)
		if not profile then
			return nil
		end
		return {
			cash = profile.cash,
			netWorth = netWorth(profile),
			holdings = profile.holdings,
			prices = marketPrices,
			history = profile.tradeHistory,
			outfit = profile.outfit,
			car = profile.car,
			property = profile.property,
			quests = profile.quests,
		}
	elseif action == "trade" then
		return trade(player, args[1], args[2], args[3] == true)
	elseif action == "purchase" then
		return purchase(player, args[1], args[2])
	elseif action == "casino" then
		local profile = getProfile(player)
		local bet = math.floor(tonumber(args[1]) or 0)
		if not profile or bet &lt; 1 or bet &gt; 5_000 then
			return false, "Invalid bet"
		end
		if os.time() - profile.lastCasinoUnix &gt;= 86400 then
			profile.lastCasinoUnix = os.time()
			profile.casinoLossToday = 0
		end
		if profile.casinoLossToday &gt;= Config.MaxCasinoLossPerDay then
			return false, "Daily loss limit reached"
		end
		if profile.cash &lt; bet then
			return false, "Not enough credits"
		end
		local win = math.random() &lt; 0.46
		if win then
			local winnings = bet * 2
			profile.cash += winnings - bet
			saveProfile(player)
			return true, "Win", winnings
		end
		profile.cash -= bet
		profile.casinoLossToday += bet
		saveProfile(player)
		return true, "Lose", bet
	elseif action == "loan" then
		local profile = getProfile(player)
		if not profile then
			return false, "Profile unavailable"
		end
		if profile.quests.loanTaken then
			return false, "One active loan is already allowed"
		end
		local amount = 10_000
		profile.cash += amount
		profile.quests.loanTaken = true
		saveProfile(player)
		return true, "Loan approved"
	elseif action == "quest" then
		local profile = getProfile(player)
		if not profile then
			return false, "Profile unavailable"
		end
		if profile.quests.firstTrade then
			return false, "Quest already completed"
		end
		local hasTrade = #profile.tradeHistory &gt; 0
		if not hasTrade then
			return false, "Complete one trade first"
		end
		profile.quests.firstTrade = true
		profile.cash += 5_000
		saveProfile(player)
		return true, "Quest reward received"
	elseif action == "clan" then
		local profile = getProfile(player)
		if not profile then
			return false, "Profile unavailable"
		end
		local clanName = args[1]
		if type(clanName) ~= "string" or #clanName &lt; 3 or #clanName &gt; 24 then
			return false, "Invalid clan name"
		end
		profile.clan = clanName
		saveProfile(player)
		return true, "Clan selected"
	end

	return false, "Unknown action"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX981831D4365848C895663C3B82A336D6">
      <Properties>
        <string name="Name">LeaderboardManager</string>
        <bool name="Enabled">true</bool>
        <ProtectedString name="Source">local Players = game:GetService("Players")

local leaderboard = Instance.new("Folder")
leaderboard.Name = "Leaderboards"
leaderboard.Parent = game.ReplicatedStorage

local function addPlayer(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end

	if not stats:FindFirstChild("Reputation") then
		local reputation = Instance.new("IntValue")
		reputation.Name = "Reputation"
		reputation.Value = 0
		reputation.Parent = stats
	end

	if not stats:FindFirstChild("Trades") then
		local trades = Instance.new("IntValue")
		trades.Name = "Trades"
		trades.Value = 0
		trades.Parent = stats
	end
end

Players.PlayerAdded:Connect(addPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	addPlayer(player)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX5E072C3D40C64DDD93DCF85F16845749">
      <Properties>
        <string name="Name">SocialManager</string>
        <bool name="Enabled">true</bool>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remote = ReplicatedStorage:FindFirstChild("SocialRemote") or Instance.new("RemoteFunction")
Remote.Name = "SocialRemote"
Remote.Parent = ReplicatedStorage

local trades = {}
local clans = {}

local function findPlayer(name)
	for _, player in ipairs(Players:GetPlayers()) do
		if string.lower(player.Name) == string.lower(name) then
			return player
		end
	end
end

Remote.OnServerInvoke = function(player, action, ...)
	local args = table.pack(...)

	if action == "tradeOffer" then
		local target = findPlayer(tostring(args[1]))
		local asset = tostring(args[2])
		local quantity = math.floor(tonumber(args[3]) or 0)
		if not target or target == player or quantity &lt; 1 or quantity &gt; 1000 then
			return false, "Invalid trade offer"
		end
		trades[target.UserId] = {
			from = player,
			asset = asset,
			quantity = quantity,
			accepted = false,
		}
		return true, "Offer sent"
	end

	if action == "tradeAccept" then
		local offer = trades[player.UserId]
		if not offer then
			return false, "No pending offer"
		end
		trades[player.UserId] = nil
		offer.accepted = true
		return true, "Offer accepted", offer.from.Name
	end

	if action == "joinClan" then
		local clanName = tostring(args[1])
		if #clanName &lt; 3 or #clanName &gt; 24 then
			return false, "Invalid clan name"
		end
		clans[clanName] = clans[clanName] or {}
		clans[clanName][player.UserId] = true
		return true, "Clan joined"
	end

	if action == "clanMembers" then
		local clanName = tostring(args[1])
		local count = 0
		for _ in pairs(clans[clanName] or {}) do
			count += 1
		end
		return true, count
	end

	return false, "Unknown action"
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX1E901FE3DAD24FFB8D7822399E788B66">
      <Properties>
        <string name="Name">NPCManager</string>
        <bool name="Enabled">true</bool>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local npcFolder = Workspace:FindFirstChild("NPCs") or Instance.new("Folder")
npcFolder.Name = "NPCs"
npcFolder.Parent = Workspace

local routes = {
	{ Vector3.new(-30, 4, 105), Vector3.new(30, 4, 105), Vector3.new(100, 4, 105) },
	{ Vector3.new(-130, 4, -40), Vector3.new(-130, 4, 40), Vector3.new(-130, 4, 120) },
	{ Vector3.new(130, 4, -100), Vector3.new(130, 4, 20), Vector3.new(130, 4, 120) },
}

local roles = {
	"Street Vendor",
	"Bank Teller",
	"News Reporter",
	"Car Dealer",
	"Stock Analyst",
	"Construction Worker",
	"Taxi Driver",
}

for index, role in ipairs(roles) do
	local route = routes[((index - 1) % #routes) + 1]
	local npc = Instance.new("Model")
	npc.Name = role
	npc.Parent = npcFolder

	local body = Instance.new("Part")
	body.Name = "HumanoidRootPart"
	body.Anchored = false
	body.Size = Vector3.new(2, 5, 1)
	body.Position = route[1]
	body.BrickColor = BrickColor.new(index % 2 == 0 and "Institutional white" or "Reddish brown")
	body.Parent = npc

	local humanoid = Instance.new("Humanoid")
	humanoid.WalkSpeed = 5
	humanoid.Parent = npc

	local root = body
	task.spawn(function()
		while npc.Parent do
			for _, point in ipairs(route) do
				humanoid:MoveTo(point)
				humanoid.MoveToFinished:Wait()
				task.wait(1 + (index % 3))
			end
		end
	end)
end
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX_STARTERPLAYER">
    <Item class="StarterPlayerScripts" referent="RBX_STARTERSCRIPTS">
      <Item class="LocalScript" referent="RBX5CB4EC246EC04CAD9186CA502D73B903">
        <Properties>
          <string name="Name">GameUI</string>
          <bool name="Enabled">true</bool>
          <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("MarketConfig"))
local remote = ReplicatedStorage:WaitForChild("EconomyRemote")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function placeCameraOnPlayer()
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root then
		local camera = Workspace.CurrentCamera
		camera.CameraSubject = character:WaitForChild("Humanoid", 10)
		camera.CameraType = Enum.CameraType.Custom
		camera.CFrame = CFrame.new(Vector3.new(18, 14, 28), root.Position)
	end
end

player.CharacterAdded:Connect(function(character)
	task.defer(placeCameraOnPlayer)
end)
task.spawn(placeCameraOnPlayer)

local gui = Instance.new("ScreenGui")
gui.Name = "WealthFrontierUI"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local top = Instance.new("Frame")
top.Name = "TopBar"
top.Size = UDim2.new(1, 0, 0, 52)
top.BackgroundColor3 = Color3.fromRGB(11, 15, 24)
top.BorderSizePixel = 0
top.Parent = gui

local cashLabel = Instance.new("TextLabel")
cashLabel.Name = "Cash"
cashLabel.Size = UDim2.new(0, 260, 1, 0)
cashLabel.Position = UDim2.new(0, 16, 0, 0)
cashLabel.BackgroundTransparency = 1
cashLabel.Font = Enum.Font.GothamBold
